rules_version = '2';

// =============================================================================
// KCC — Cloud Storage security rules
//
// Only staff upload. Everyone can read, because these are the photos on the
// public site.
//
// Deploy with:  firebase deploy --only storage
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Same hierarchy as firestore.rules: owner, admin and manager look after
    // photos. Staff handle bookings, not content.
    function canManageContent() {
      return request.auth != null
        && (
          (request.auth.token.email != null
            && request.auth.token.email.lower() == 'theking19942010@gmail.com')
          || (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
              && firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
                   .data.role in ['owner', 'admin', 'manager'])
        );
    }

    // contentType is attacker-controlled, so the size cap does the heavy
    // lifting; the real protection is that only admins can write at all.
    function isImageUnder5MB() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)');
    }

    match /rooms/{fileName} {
      allow read: if true;
      allow write: if canManageContent() && isImageUnder5MB();
    }

    match /menu/{fileName} {
      allow read: if true;
      allow write: if canManageContent() && isImageUnder5MB();
    }

    // Nothing else is writable.
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
